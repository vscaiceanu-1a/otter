{
  "name": "@o3r/schematics",
  "version": "0.0.0-placeholder",
  "publishConfig": {
    "access": "public"
  },
  "description": "Schematics module of the Otter framework",
  "main": "./src/public_api.ts",
  "typings": "./src/public_api.ts",
  "keywords": [
    "schematics",
    "otter"
  ],
  "scripts": {
    "nx": "nx",
    "ng": "yarn nx",
    "build": "yarn nx build schematics",
    "postbuild": "yarn cpy 'package.json' dist && patch-package-json-main",
    "prepare:publish": "prepare-publish ./dist",
    "prepare:build:builders": "yarn cpy 'schematics/**/*.json' dist/schematics && yarn cpy 'collection.json' dist",
    "build:source": "tsc -b tsconfig.build.json --pretty",
    "build:builders": "tsc -b tsconfig.builders.json --pretty && yarn generate-cjs-manifest",
    "build:cli": "tsc -b tsconfig.cli.json --pretty && yarn generate-cjs-manifest"
  },
  "bin": {
    "o3r-environment": "./dist/cli/environment.js"
  },
  "peerDependencies": {
    "@angular-devkit/architect": "~0.1802.0",
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@o3r/telemetry": "workspace:^",
    "@schematics/angular": "~20.3.0",
    "eslint": "~9.14.0",
    "rxjs": "^7.8.1",
    "type-fest": "^5.0.0",
    "typescript": "~5.5.4"
  },
  "peerDependenciesMeta": {
    "@angular-devkit/architect": {
      "optional": true
    },
    "@angular-devkit/core": {
      "optional": true
    },
    "@angular/cli": {
      "optional": true
    },
    "@o3r/telemetry": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "type-fest": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "globby": "^11.1.0",
    "inquirer": "~12.9.0",
    "minimatch": "~10.0.0",
    "semver": "^7.5.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.0",
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/animations": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@babel/core": "~7.26.0",
    "@babel/preset-typescript": "~7.26.0",
    "@compodoc/compodoc": "^1.1.19",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@nx/eslint": "~21.5.0",
    "@nx/eslint-plugin": "~21.5.0",
    "@nx/jest": "~21.5.0",
    "@nx/js": "~21.5.0",
    "@o3r/build-helpers": "workspace:^",
    "@o3r/eslint-plugin": "workspace:^",
    "@o3r/telemetry": "workspace:^",
    "@schematics/angular": "~20.3.0",
    "@stylistic/eslint-plugin": "~5.3.0",
    "@types/inquirer": "~9.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.3.13",
    "@typescript-eslint/parser": "~8.16.0",
